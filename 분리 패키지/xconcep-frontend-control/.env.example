WEB_PORT=8080
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=false
DB_ENGINE=mysql
MYSQL_DATABASE=xconcep
MYSQL_USER=xconcep
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-root-me
MAX_UPLOAD_MB=30
SYNC_PIPELINE=true
INSTALL_NAT=false
AGENT_RUNTIME=fallback

# Core local AI
PIPELINE_MODE=mock
LLM_MODE=mock
VLLM_BASE_URL=http://GPU-RAY-HEAD:8000/v1
VLLM_API_KEY=local-not-required
GEMMA_MODEL_NAME=gemma-4-64b-local
OPENAI_IMAGE_MODE=mock
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
HUNYUAN_MODE=mock
HUNYUAN_API_URL=http://HUNYUAN3D-SERVER:8081

# Meeting voice: nemo_asr / faster_whisper / nvidia_nim / mock
SPEECH_MODE=mock
INSTALL_NEMO_SPEECH=false
INSTALL_SPEECH=false
NEMO_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3
NEMO_DIARIZER_CONFIG=
DIARIZATION_MODE=none
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
NVIDIA_ASR_URL=http://ASR-NIM:9000

# RAG
QDRANT_COLLECTION=xconcep_memory
EMBED_MODE=hash
EMBED_URL=http://EMBEDDING-NIM:8000
EMBED_MODEL=nvidia/nv-embedqa-e5-v5
EMBED_DIM=384

# OpenUSD / Omniverse
OPENUSD_GENERATE_USDC=true
OMNIVERSE_ENABLED=true
OMNIVERSE_GENERATE_LAYERS=true
OMNIVERSE_ENABLE_PHYSICS=true
OMNIVERSE_ENABLE_VARIANTS=true
OMNIVERSE_NUCLEUS_URL=
OMNIVERSE_STREAM_URL=

# Optional NVIDIA NeMo Retriever Library document extraction
INSTALL_NEMO_RETRIEVER=false
NEMO_RETRIEVER_MODE=fallback

# Multi-route 3D generation
# auto: native binary if installed, otherwise safe fallback
OPENSCAD_MODE=auto
OPENSCAD_BIN=openscad
OPENSCAD_TIMEOUT_SECONDS=600
INSTALL_OPENSCAD=false
BLENDER_MODE=auto
BLENDER_BIN=blender
BLENDER_TIMEOUT_SECONDS=1800
INSTALL_BLENDER=false
ROUTING_LOW_CONFIDENCE=0.60
ROUTING_HIGH_CONFIDENCE=0.80
VALIDATION_DIMENSION_TOLERANCE_PCT=5.0
ENABLE_PARALLEL_PREVIEW=true
