WEB_PORT=8080
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=false
DB_ENGINE=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=xconcep
MYSQL_USER=xconcep
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-root-me
MYSQL_CONN_MAX_AGE=60
DB_CONNECT_RETRIES=60
# Optional CA path for TLS when the application database is remote.
MYSQL_SSL_CA=

# User authentication. Internal MySQL is the current test mode.
# disabled / internal_db / corporate_db
AUTH_MODE=internal_db
AUTH_TOKEN_TTL_SECONDS=28800
INTERNAL_AUTH_BOOTSTRAP_ENABLED=true
INTERNAL_AUTH_USERNAME=internal_admin
INTERNAL_AUTH_PASSWORD=replace-with-local-test-password
INTERNAL_AUTH_DISPLAY_NAME=내부 테스트 관리자
INTERNAL_AUTH_EMAIL=internal-admin@example.test

# Future external corporate MySQL mapping. Ignored while AUTH_MODE=internal_db.
AUTH_DB_ENGINE=mysql
AUTH_DB_HOST=
AUTH_DB_PORT=3306
AUTH_DB_NAME=
AUTH_DB_USER=
AUTH_DB_PASSWORD=
AUTH_DB_CONN_MAX_AGE=60
AUTH_DB_CONNECT_TIMEOUT=5
AUTH_DB_SSL_CA=
# Identifiers only: letters, numbers, underscore and an optional schema prefix.
AUTH_DB_TABLE=employees
AUTH_DB_ID_COLUMN=id
AUTH_DB_USERNAME_COLUMN=username
AUTH_DB_PASSWORD_COLUMN=password_hash
AUTH_DB_DISPLAY_NAME_COLUMN=display_name
AUTH_DB_EMAIL_COLUMN=email
AUTH_DB_ACTIVE_COLUMN=is_active
# django_hash verifies Django/PBKDF2/bcrypt/argon2 formatted hashes through Django.
AUTH_DB_PASSWORD_SCHEME=django_hash
AUTH_DB_USERNAME_CASE_SENSITIVE=false
MAX_UPLOAD_MB=128
MAX_IMAGE_UPLOAD_MB=12
MAX_AUDIO_UPLOAD_MB=30
MAX_REQUEST_UPLOAD_MB=128
INTERNAL_API_TOKEN=
CORS_ALLOW_ALL=false
SYNC_PIPELINE=false
INSTALL_NAT=false
AGENT_RUNTIME=fallback

# Core local AI
PIPELINE_MODE=mock
# rules / vllm / openai_compatible / ollama / mock
# `rules` is offline and deterministic; it does not impersonate an LLM.
LLM_MODE=rules
VLLM_BASE_URL=http://GPU-RAY-HEAD:8000/v1
VLLM_API_KEY=local-not-required
GEMMA_MODEL_NAME=gemma-4-64b-local
LLM_TIMEOUT_SECONDS=600
# Ollama example: VLLM_BASE_URL=http://host.docker.internal:11434/v1, GEMMA_MODEL_NAME=qwen3:14b
# 기본: comfyui (로컬 FLUX), 선택: openai, 테스트: mock
OPENAI_IMAGE_MODE=comfyui
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_TIMEOUT_SECONDS=600
# 0 disables the corresponding ceiling. Set an estimated per-image amount for budget enforcement.
OPENAI_IMAGE_MAX_REQUESTS_PER_DAY=20
OPENAI_IMAGE_ESTIMATED_COST_USD=0
OPENAI_IMAGE_MAX_ESTIMATED_COST_USD_PER_DAY=0
OPENAI_IMAGE_USAGE_DB=/app/storage/usage/openai-image.sqlite3
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_API_KEY=
COMFYUI_TIMEOUT_SECONDS=900
COMFYUI_UNET_MODEL=flux-2-klein-base-4b-fp8.safetensors
COMFYUI_CLIP_MODEL=qwen_3_4b.safetensors
COMFYUI_VAE_MODEL=flux2-vae.safetensors
COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=1024
COMFYUI_STEPS=20
COMFYUI_CFG=5.0
COMFYUI_MAX_ATTEMPTS=2

# Generated image acceptance checks.
IMAGE_CONCEPT_COUNT=4
IMAGE_MIN_WIDTH=768
IMAGE_MIN_HEIGHT=768
IMAGE_MIN_FILE_BYTES=10000
IMAGE_MIN_CHANNEL_STDDEV=3.0
IMAGE_REQUIRE_EXPECTED_ASPECT=true
IMAGE_SEMANTIC_VERIFIER_URL=
IMAGE_SEMANTIC_VERIFIER_API_KEY=
IMAGE_SEMANTIC_VERIFIER_TIMEOUT_SECONDS=120
# Local image-to-3D default. The external route alias remains `hunyuan3d` for API compatibility.
SHAPE_MODE=triposr
SHAPE_PROVIDER=triposr
SHAPE_API_URL=http://host.docker.internal:8081
SHAPE_TIMEOUT_SECONDS=1800

# Meeting voice: nemo_asr / faster_whisper / nvidia_nim / mock
SPEECH_MODE=mock
INSTALL_NEMO_SPEECH=false
INSTALL_SPEECH=false
NEMO_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3
NEMO_DIARIZER_CONFIG=
DIARIZATION_MODE=none
WHISPER_MODEL=large-v3-turbo
WHISPER_MODEL_CACHE=/app/storage/models/whisper
# auto는 CUDA를 우선 사용하고 로컬 CUDA 런타임 문제가 있으면 CPU로 재시도
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
NVIDIA_ASR_URL=http://ASR-NIM:9000
NVIDIA_ASR_API_KEY=
PYANNOTE_TOKEN=

# RAG
QDRANT_COLLECTION=xconcep_memory
EMBED_MODE=hash
EMBED_URL=http://EMBEDDING-NIM:8000
EMBED_MODEL=nvidia/nv-embedqa-e5-v5
EMBED_DIM=384

# OpenUSD / Omniverse
OPENUSD_GENERATE_USDC=true
OMNIVERSE_ENABLED=true
OMNIVERSE_GENERATE_LAYERS=true
OMNIVERSE_ENABLE_PHYSICS=true
OMNIVERSE_ENABLE_VARIANTS=true
OMNIVERSE_NUCLEUS_URL=
OMNIVERSE_STREAM_URL=

# Optional NVIDIA NeMo Retriever Library document extraction
INSTALL_NEMO_RETRIEVER=false
NEMO_RETRIEVER_MODE=fallback

# Multi-route 3D generation
# auto: native binary if installed, otherwise safe fallback
OPENSCAD_MODE=auto
OPENSCAD_BIN=openscad
OPENSCAD_TIMEOUT_SECONDS=600
INSTALL_OPENSCAD=false
BLENDER_MODE=auto
BLENDER_BIN=blender
BLENDER_TIMEOUT_SECONDS=1800
INSTALL_BLENDER=false
ROUTING_LOW_CONFIDENCE=0.60
ROUTING_HIGH_CONFIDENCE=0.80
VALIDATION_DIMENSION_TOLERANCE_PCT=5.0
SELF_FEEDBACK_ENABLED=true
SELF_FEEDBACK_TARGET=0.95
SELF_FEEDBACK_MAX_ATTEMPTS=3
ENABLE_PARALLEL_PREVIEW=true
