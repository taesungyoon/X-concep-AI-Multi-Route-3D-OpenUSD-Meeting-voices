{
  "model": {
    "base_model": "Qwen/Qwen3-VL-4B-Instruct",
    "load_in_4bit": true,
    "finetune_vision_layers": true,
    "finetune_language_layers": true,
    "finetune_attention_modules": true,
    "finetune_mlp_modules": true,
    "max_pixels": 262144
  },
  "data": {
    "dataset_dir": "data/php-api-e2e-smoke-v1",
    "target_type": "design_spec",
    "train_split": "train",
    "max_images": 1,
    "limit_train": 1
  },
  "training": {
    "output_dir": "outputs/qwen3-vl-4b-php-cad-smoke",
    "num_train_epochs": 1,
    "max_steps": 1,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.00008,
    "warmup_ratio": 0.0,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "lr_scheduler_type": "cosine",
    "optim": "adamw_8bit",
    "bf16": true,
    "fp16": false,
    "logging_steps": 1,
    "save_steps": 1,
    "save_total_limit": 1,
    "resume_from_checkpoint": false,
    "seed": 3407,
    "world_size": 1
  },
  "lora": {"r": 8, "alpha": 16, "dropout": 0.0, "use_rslora": false},
  "tracking": {"report_to": ["tensorboard", "trackio"], "project": "xconcep-cad-vlm", "run_name": "php-cad-e2e-smoke"},
  "hub": {"enabled": false, "repo_id": "", "private": true, "push_checkpoints": false}
}
