{
  "name": "xconcep/cad-ai-preprocessor",
  "description": "PHP full-stack DXF/STEP AI dataset preprocessing reference",
  "type": "project",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "ext-pdo": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "CadAi\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "validate:10000": "php tests/validate_10000.php"
  }
}
